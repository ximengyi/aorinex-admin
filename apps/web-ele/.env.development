# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址（浏览器请求 /api/*，由 Vite 代理到 VITE_DEV_PROXY_TARGET）
VITE_GLOB_API_URL=/api

# dev 代理目标（真实后端根地址，不含路径）
VITE_DEV_PROXY_TARGET=http://192.168.71.43:8787

# 是否开启 Nitro Mock服务；对接真实接口时请设为 false
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
